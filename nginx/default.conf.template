map $uri $relay_cache_control {
    ~^/(api|h|socket\.io)/ "";
    ~^/assets/ "public, max-age=31536000, immutable";
    default "no-cache";
}

map $http_host $relay_ws_host {
    ~^(?<host_port>[A-Za-z0-9.:-]+)$ $host_port;
    default "";
}

map $http_upgrade $relay_connection {
    default upgrade;
    "" "";
}

map $http_x_forwarded_proto $relay_proto {
    https https;
    default $scheme;
}

map $uri $relay_log_path {
    "~^/h/(?<slug_head>[^/]{1,6})" /h/$slug_head...;
    default $uri;
}

map $relay_proto $relay_hsts {
    https "max-age=31536000; includeSubDomains";
    default "";
}

map $request_method $relay_auth_key {
    GET "";
    default $binary_remote_addr;
}

limit_req_zone $binary_remote_addr zone=relay_api:10m rate=10r/s;
limit_req_zone $relay_auth_key zone=relay_auth:10m rate=10r/m;
limit_req_zone $binary_remote_addr zone=relay_ingest:10m rate=50r/s;
limit_conn_zone $binary_remote_addr zone=relay_conn:10m;

log_format relay '$remote_addr [$time_local] "$request_method $relay_log_path" $status $body_bytes_sent $request_time';

server {
    listen 80;
    server_tokens off;
    access_log /var/log/nginx/access.log relay;
    root /usr/share/nginx/html;
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $relay_api ${RELAY_API_UPSTREAM};
    set $relay_ingest ${RELAY_INGEST_UPSTREAM};

    limit_req_status 429;
    limit_conn_status 429;
    limit_conn relay_conn 50;
    client_header_timeout 10s;
    client_body_timeout 10s;
    send_timeout 10s;
    keepalive_timeout 15s;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Content-Security-Policy "default-src 'self'; connect-src 'self' ws://$relay_ws_host wss://$relay_ws_host; img-src 'self' data:; style-src 'self' 'unsafe-inline'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;
    add_header Strict-Transport-Security $relay_hsts always;
    add_header Cache-Control $relay_cache_control;

    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Proto $relay_proto;

    location / {
        try_files $uri /index.html;
    }

    location /assets/ {
        try_files $uri =404;
    }

    location /api/ {
        client_max_body_size 128k;
        limit_req zone=relay_api burst=40 nodelay;
        proxy_pass $relay_api;
    }

    location /api/v1/auth/ {
        client_max_body_size 128k;
        limit_req zone=relay_api burst=40 nodelay;
        limit_req zone=relay_auth burst=10 nodelay;
        proxy_pass $relay_api;
    }

    location /h/ {
        client_max_body_size 10m;
        limit_req zone=relay_ingest burst=100 nodelay;
        proxy_pass $relay_ingest;
    }

    location /socket.io/ {
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $relay_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $relay_connection;
        proxy_read_timeout 1h;
        limit_req zone=relay_api burst=20 nodelay;
        proxy_pass $relay_api;
    }
}
